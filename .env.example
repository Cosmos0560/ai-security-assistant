# Copy to .env (git-ignored) in the folder where you run `aisa triage`.
#
# Only these four keys are accepted. A real environment variable wins over this file, and an
# empty value counts as unset. Write comments on their own line, not after a value.
# The API key is NEVER read from this file: set ANTHROPIC_API_KEY in the environment instead.
# `aisa eval` ignores this file and LLM_PROVIDER; a non-mock eval needs an explicit --provider.

# mock (default, offline), mock-naive, anthropic or ollama
LLM_PROVIDER=mock

# Ollama is local only: http or https on localhost, 127.0.0.1 or [::1], no path.
OLLAMA_BASE_URL=http://localhost:11434
# Pull the model yourself first (`ollama pull qwen3:8b`); aisa never pulls anything.
OLLAMA_MODEL=qwen3:8b
# Per request, 1 to 3600. A CPU-only 8B model needs minutes per alert.
OLLAMA_TIMEOUT_SECONDS=600
